    "Restores your charge limit as soon as you disconnect the charger.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores your charge limit as soon as you disconnect the charger."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục giới hạn sạc ngay khi bạn rút bộ sạc ra khỏi máy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電器を取り外すとすぐに充電上限を元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전기를 분리하는 즉시 충전 제한을 복원합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "断开充电器后立即恢复您的充电上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "中斷充電器後立即恢復您的充電上限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit votre limite de charge dès que le chargeur est débranché."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Ladelimit sofort nach dem Abziehen des Ladegeräts wieder her."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura tu límite de carga en cuanto desconectas el cargador."
          }
        }
      }
    },
    "Restores your charge limit automatically as soon as the battery reaches 100%.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores your charge limit automatically as soon as the battery reaches 100%."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động khôi phục giới hạn sạc ngay khi pin chạm mức 100% lần đầu tiên."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーが初めて 100% に達すると自動的に充電上限を元に戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 처음으로 100%에 도달하면 충전 제한을 자동으로 복원합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电池首次充至 100% 后自动恢复您的充电上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電池首次充至 100% 後自動恢復您的充電上限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rétablit automatiquement la limite dès que la batterie atteint 100 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt das Ladelimit automatisch wieder her, sobald 100 % erreicht sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura automáticamente el límite en cuanto la batería llega al 100 %."
          }
        }
      }
    },
