    "Protect your battery's long-term health with a suite of safeguards.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protect your battery's long-term health with a suite of safeguards."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bảo vệ tuổi thọ pin lâu dài với các thiết lập sạc thông minh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリーの長期的な健康を守るための保護機能を設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다양한 보호 기능으로 배터리의 장기적인 수명을 보호하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过多种保护机制延长电池的长期健康寿命。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過多種保護機制延長電池的長期健康壽命。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préservez la santé de votre batterie à long terme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schützen Sie die langfristige Batteriegesundheit mit gezielten Schutzfunktionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Protege la salud de tu batería a largo plazo."
          }
        }
      }
    },
