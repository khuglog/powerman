    "Pair your AirPods, Magic Mouse, Keyboard, or other Bluetooth accessories in System Settings → Bluetooth, then click Refresh.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pair your AirPods, Magic Mouse, Keyboard, or other Bluetooth accessories in System Settings → Bluetooth, then click Refresh."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghép đôi AirPods, Magic Mouse, Keyboard hoặc phụ kiện Bluetooth khác trong Cài đặt hệ thống → Bluetooth, rồi bấm Làm mới."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」→「Bluetooth」で AirPods やマウス、キーボードなどをペアリングしてから「更新」をクリックしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → Bluetooth에서 AirPods, Magic Mouse, 키보드 등을 페어링한 후 새로고침을 클릭하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”→“蓝牙”中配对您的 AirPods、妙控鼠标、键盘等配件，然后点击刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」→「藍牙」中配對您的 AirPods、巧控滑鼠、鍵盤等配件，然後點擊重新整理。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jumelez vos accessoires dans Réglages Système → Bluetooth, puis cliquez sur Actualiser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppeln Sie Geräte unter Systemeinstellungen → Bluetooth und klicken Sie auf Aktualisieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlaza tus accesorios en Ajustes del Sistema → Bluetooth y pulsa Actualizar."
          }
        }
      }
    },
    "Pause charging at your target so the battery sits in a healthier range.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause charging at your target so the battery sits in a healthier range."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng sạc ở mức đã chọn để giúp pin bền hơn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定した目標値で充電を一時停止し、バッテリーをより健康的な範囲に保ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정한 목표 수준에서 충전을 일시 중지하여 배터리를 더 건강한 상태로 유지합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在目标电量暂停充电，让电池保持在更健康的区间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在目標電量暫停充電，讓電池維持在更健康的區間。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Met la charge en pause au seuil cible pour préserver la batterie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausiert den Ladevorgang beim Zielwert für eine gesündere Batterienutzung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa la carga al alcanzar el objetivo para cuidar la batería."
          }
        }
      }
    },
