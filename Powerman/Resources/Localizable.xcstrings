    "Powerman tracks battery discharge and active battery time across each day. Keep Powerman running to fill in your daily charts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman tracks battery discharge and active battery time across each day. Keep Powerman running to fill in your daily charts."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman theo dõi mức xả pin và thời gian dùng pin mỗi ngày. Hãy giữ Powerman chạy nền để cập nhật biểu đồ hàng ngày."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman は日々のバッテリー消費量と稼働時間を記録します。グラフを作成するには Powerman を起動したままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman은 매일 배터리 소모량과 사용 시간을 추적합니다. 일일 차트를 채우려면 Powerman을 계속 실행하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman 会统计每日电池消耗和使用时长。保持应用运行即可完善每日图表。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman 會統計每日電池消耗與使用時間。保持應用程式執行即可完善每日圖表。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman suit la décharge et le temps d'utilisation quotidiens. Gardez l'app ouverte pour remplir les graphiques."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman erfasst die tägliche Entladung und Akkulaufzeit. Lassen Sie die App laufen, um die Diagramme zu füllen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman registra el consumo y tiempo diario. Mantén la app abierta para completar los gráficos."
          }
        }
      }
    },
