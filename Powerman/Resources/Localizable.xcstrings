    "Auto follows your Mac's system appearance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto follows your Mac's system appearance"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động theo giao diện hệ thống của máy Mac"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「自動」は Mac のシステム外観に合わせます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자동은 Mac의 시스템 화면 모드를 따릅니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动跟随 Mac 的系统外观设置"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動跟隨 Mac 的系統外觀設定"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto suit l'apparence système de votre Mac"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatisch folgt dem macOS-Erscheinungsbild"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Automático sigue la apariencia del sistema de tu Mac"
          }
        }
      }
    },
    "Automatically closes system battery notification on the top right so you don't have to click it away.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically closes system battery notification on the top right so you don't have to click it away."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động đóng thông báo pin hệ thống ở góc trên bên phải để bạn không phải bấm tắt thủ công."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上に表示される macOS のバッテリー通知を自動的に閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오른쪽 상단에 뜨는 시스템 배터리 알림을 자동으로 닫습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动关闭右上角的系统电池通知，无需手动点击关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動關閉右上角的系統電池通知，無需手動點擊關閉。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme automatiquement les notifications batterie de macOS en haut à droite."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließt macOS-Batteriemitteilungen oben rechts automatisch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra automáticamente las notificaciones de batería del sistema arriba a la derecha."
          }
        }
      }
    },
