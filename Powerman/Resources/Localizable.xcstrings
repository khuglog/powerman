    "Monitor battery levels of your AirPods, Beats, Magic Mouse, Keyboard, Trackpad, and other paired Bluetooth devices.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor battery levels of your AirPods, Beats, Magic Mouse, Keyboard, Trackpad, and other paired Bluetooth devices."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Theo dõi mức pin của AirPods, Beats, Magic Mouse, Keyboard, Trackpad và các thiết bị Bluetooth đã ghép đôi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods、Beats、Magic Mouse、Keyboard、Trackpad などのペアリング済み Bluetooth デバイスのバッテリー残量を監視します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AirPods, Beats, Magic Mouse, Keyboard, Trackpad 및 기타 페어링된 Bluetooth 기기의 배터리를 모니터링하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "监测 AirPods、Beats、妙控鼠标、键盘、触控板及其他已配对蓝牙设备的电量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "監測 AirPods、Beats、巧控滑鼠、鍵盤、觸控式軌跡板及其他已配對藍牙裝置的電量。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Surveillez la batterie de vos AirPods, Beats, Magic Mouse, clavier, trackpad et autres appareils Bluetooth."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Batteriestand von AirPods, Beats, Magic Mouse, Tastatur, Trackpad und weiteren Bluetooth-Geräten überwachen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Supervisa la batería de tus AirPods, Beats, Magic Mouse, teclado, trackpad y otros dispositivos Bluetooth."
          }
        }
      }
    },
