    "macOS offers limits from 80 to 100 percent, in steps of 5.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS offers limits from 80 to 100 percent, in steps of 5."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS hỗ trợ các mức giới hạn từ 80% đến 100%, mỗi bước 5%."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS では 80% から 100% まで 5% 刻みで上限を設定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS는 80%에서 100%까지 5% 단위로 제한을 제공합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 支持以 5% 为步长设置 80% 至 100% 的上限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 支援以 5% 為級距設定 80% 至 100% 的上限。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS propose des limites de 80 à 100 %, par paliers de 5 %."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS bietet Limits von 80 bis 100 Prozent in 5er-Schritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS ofrece límites del 80 al 100 %, en pasos de 5."
          }
        }
      }
    },
