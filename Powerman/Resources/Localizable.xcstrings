    "Brings back your previous brightness when you turn Low Power Mode off from Powerman's menu.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings back your previous brightness when you turn Low Power Mode off from Powerman's menu."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khôi phục độ sáng trước đó khi tắt Chế độ nguồn điện thấp từ menu của Powerman."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman のメニューから低電力モードをオフにしたとき、元の画面の明るさに戻します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Powerman 메뉴에서 저전력 모드를 끌 때 이전 밝기로 복원합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从 Powerman 菜单关闭低电量模式时，恢复之前的屏幕亮度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從 Powerman 選單關閉低耗電模式時，恢復先前的螢幕亮度。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure la luminosité précédente lorsque vous désactivez le mode économie d'énergie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt die vorherige Helligkeit wieder her, wenn der Stromsparmodus beendet wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el brillo anterior al desactivar el modo de bajo consumo desde Powerman."
          }
        }
      }
    },
    "Building your battery-level history — your charge timeline fills in as you use your Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building your battery-level history — your charge timeline fills in as you use your Mac."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang ghi nhận lịch sử pin — biểu đồ sẽ dần cập nhật khi bạn sử dụng máy Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バッテリー履歴を構築中 — Mac の使用に合わせてタイムラインが埋まります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리 잔량 기록을 수집 중입니다 — Mac을 사용하는 동안 타임라인이 채워집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在记录电量历史 — 随着您使用 Mac，曲线将逐步完善。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在記錄電量歷史 — 隨著您使用 Mac，曲線將逐步完善。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Constitution de l'historique — la courbe se remplit à l'usage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Batterieverlauf wird aufgebaut — füllt sich bei der Nutzung Ihres Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recopilando historial de batería — la gráfica se llenará con el uso."
          }
        }
      }
    },
