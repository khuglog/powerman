    "You can hide macOS default battery icon in System Settings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can hide macOS default battery icon in System Settings"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể ẩn biểu tượng pin mặc định của macOS trong Cài đặt hệ thống"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 標準のバッテリーアイコンはシステム設定で非表示にできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 macOS 기본 배터리 아이콘을 숨길 수 있습니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在“系统设置”中隐藏 macOS 默认电池图标"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在「系統設定」中隱藏 macOS 預設電池圖示"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez masquer l'icône batterie de macOS dans Réglages Système"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Standard-Batteriesymbol lässt sich in den Systemeinstellungen ausblenden"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes ocultar el icono de batería de macOS en Ajustes del Sistema"
          }
        }
      }
    },
    "You'll find the same limit in System Settings → Battery.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You'll find the same limit in System Settings → Battery."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn sẽ thấy cùng mức giới hạn này trong Cài đặt hệ thống → Pin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ上限設定が「システム設定」→「バッテリー」にも反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 배터리에서도 동일한 제한을 확인할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在“系统设置”→“电池”中看到相同的上限设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您可以在「系統設定」→「電池」中看到相同的上限設定。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous retrouverez la même limite dans Réglages Système → Batterie."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dasselbe Limit finden Sie unter Systemeinstellungen → Batterie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encontrarás el mismo límite en Ajustes del Sistema → Batería."
          }
        }
      }
    },
