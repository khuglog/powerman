    "Devices are ranked by battery level, lowest first, so the one that needs charging is always at the top.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Devices are ranked by battery level, lowest first, so the one that needs charging is always at the top."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết bị được xếp theo mức pin từ thấp đến cao để thiết bị cần sạc luôn nằm ở trên cùng."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスはバッテリー残量が少ない順に並ぶため、充電が必要なものが常に上位に表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기는 배터리 잔량이 낮은 순으로 정렬되어 충전이 필요한 기기가 항상 위에 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备按电量从低到高排列，需要充电的设备始终置顶显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置按電量由低到高排列，需要充電的裝置始終置頂顯示。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les appareils sont classés du niveau le plus bas au plus haut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geräte werden nach Batteriestand sortiert – niedrigster zuerst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los dispositivos se ordenan de menor a mayor batería."
          }
        }
      }
    },
