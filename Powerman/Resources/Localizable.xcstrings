    "Approval required in System Settings → General → Login Items.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approval required in System Settings → General → Login Items."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần phê duyệt trong Cài đặt hệ thống → Cài đặt chung → Mục đăng nhập."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「システム設定」→「一般」→「ログイン項目」で許可が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정 → 일반 → 로그인 항목에서 승인이 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在“系统设置”→“通用”→“登录项”中批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "需要在「系統設定」→「一般」→「登入項目」中核准。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approbation requise dans Réglages Système → Général → Ouverture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freigabe unter Systemeinstellungen → Allgemein → Anmeldeobjekte erforderlich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere aprobación en Ajustes del Sistema → General → Ítems de inicio."
          }
        }
      }
    },
