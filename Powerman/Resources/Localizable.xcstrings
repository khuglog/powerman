    "Notify when battery goes below percentage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notify when battery goes below percentage"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo khi pin xuống dưới ngưỡng"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "指定した割合を下回ったときに通知します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "배터리가 설정된 비율 미만으로 떨어지면 알림"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量低于指定百分比时发出提醒"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "電量低於指定百分比時發出提醒"
          }
