        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose when a temporary override triggered from the menu bar ends automatically."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn thời điểm chế độ tạm thời vượt giới hạn sạc (bật từ thanh menu) tự động kết thúc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーから開始した一時的な充電上限解除が自動終了するタイミングを選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대에서 켠 임시 충전 제한 해제가 자동으로 종료되는 시점을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
