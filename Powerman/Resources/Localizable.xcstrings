    "Lithium-ion batteries wear faster when kept continuously at 100% charge. Stopping at 80–90% while plugged in significantly reduces chemical aging.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lithium-ion batteries wear faster when kept continuously at 100% charge. Stopping at 80–90% while plugged in significantly reduces chemical aging."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pin lithium-ion chai nhanh hơn khi duy trì liên tục ở mức 100%. Dừng sạc ở mức 80–90% khi cắm điện giúp giảm đáng kể lão hóa hóa học."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リチウムイオン電池は 100% のまま維持されると劣化が早まります。80〜90% で充電を止めることで化学的劣化を大幅に抑えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "리튬 이온 배터리는 100% 상태로 계속 유지되면 수명이 빨리 줄어듭니다. 전원을 연결한 상태에서 80~90%로 제한하면 화학적 노화를 크게 줄일 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锂离子电池长期保持在 100% 电量会加速老化。插电时将电量限制在 80–90% 可显著减缓电池化学老化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鋰離子電池長期維持在 100% 電量會加速老化。插電時將電量限制在 80–90% 可顯著減緩電池化學老化。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les batteries lithium-ion s'usent plus vite lorsqu'elles restent constamment à 100 %. S'arrêter à 80–90 % réduit nettement le vieillissement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lithium-Ionen-Akkus altern schneller, wenn sie dauerhaft bei 100 % gehalten werden. Ein Stopp bei 80–90 % schont die Batterie erheblich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las baterías de iones de litio se degradan más rápido al mantenerse al 100 %. Detenerse en 80–90 % reduce el envejecimiento químico."
          }
        }
      }
    },
