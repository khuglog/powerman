    "Most devices provide exact battery levels. Approximate values are prefixed with a tilde (~).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Most devices provide exact battery levels. Approximate values are prefixed with a tilde (~)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hầu hết thiết bị báo mức pin chính xác. Giá trị ước lượng có dấu ngã (~) phía trước."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほとんどのデバイスは正確な残量を報告します。概算値にはチルダ (~) が付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대부분의 기기는 정확한 배터리 잔량을 제공합니다. 근사치에는 물결표(~)가 표시됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "大多数设备提供精确电量，估算值前会带有波浪号 (~)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "大多數裝置提供精確電量，估算值前會帶有波浪號 (~)。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La plupart des appareils fournissent un niveau exact. Les valeurs approximatives sont précédées de ~."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die meisten Geräte liefern exakte Werte. Schätzwerte beginnen mit einer Tilde (~)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La mayoría ofrece niveles exactos. Los valores aproximados llevan una virgulilla (~)."
          }
        }
      }
    },
