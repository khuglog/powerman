    "Green when charging, orange for low battery. Off keeps the icon neutral and only turns red when critical.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Green when charging, orange for low battery. Off keeps the icon neutral and only turns red when critical."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xanh lá khi đang sạc, cam khi pin yếu. Tắt để giữ màu trung tính và chỉ báo đỏ khi pin cạn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "充電中は緑、低バッテリー時はオレンジになります。オフにすると通常はモノトーンで、危険な残量時のみ赤くなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "충전 중에는 초록색, 배터리 부족 시 주황색으로 표시됩니다. 끄면 기본 색상을 유지하고 위험 수준일 때만 빨간색이 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充电时显示绿色，低电量时显示橙色。关闭则保持中性色，仅在极低电量时变红。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "充電時顯示綠色，低電量時顯示橙色。關閉則保持中性色，僅在極低電量時變紅。"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vert en charge, orange si faible. Désactivé, l'icône reste neutre sauf en niveau critique."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Grün beim Laden, orange bei niedrigem Stand. Aus lässt das Symbol neutral bis zum kritischen Stand."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verde al cargar, naranja si está baja. Desactivado mantiene el icono neutro salvo en nivel crítico."
          }
        }
      }
    },
